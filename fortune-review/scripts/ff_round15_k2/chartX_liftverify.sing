ring R=0,(z,A,B,C,U),dp;
poly f0=-4*A^2*B*U+6*A^2*B-2*A^2*U+4*A^2+4*A*B^3+4*A*B^2*U+2*A*B^2+4*A*B*C*U-8*A*B*C-4*A*C+2*B*C^2+2*C^2*U;
poly f1=-4*A^2*U+4*A^2+2*A*B^2+6*A*B*U-2*A*B+8*A*C*U-8*A*C-2*B^2*C-2*B*C*U-2*B*C-4*C^2*U+4*C^2;
poly f2=-2*A^2*B-2*A^2*U-2*A*B^3*U-A*B^3-2*A*B^2*U^2-2*A*B^2*U+4*A*B*C*U+4*A*C*U^2-B^3*C-2*B^2*C*U-4*B*C^2*U+2*B*C^2-4*C^2*U^2+2*C^2*U;
poly f3=4*A^2*U-4*A^2+2*A*B^2*U-4*A*B^2-2*A*B*U^2-2*A*B*U-8*A*C*U+8*A*C-B^4-2*B^3*U-2*B^2*C*U+4*B^2*C-2*B*C*U^2+6*B*C*U+4*C^2*U-4*C^2;
poly inv=z*U*A*(B^2-4*C)*(A-C)-1;
ideal K=f0,f1,f2,f3,inv;
ideal T=U-1,B+2,(A-C)^2+4*A;
matrix M=lift(K,T);
matrix PR=matrix(K)*M;
poly r1=PR[1,1]-T[1];
poly r2=PR[1,2]-T[2];
poly r3=PR[1,3]-T[3];
if(r1==0 && r2==0 && r3==0){print("CHART=X LIFT_IDENTITY_OK");}
else{print("CHART=X LIFT_IDENTITY_MISMATCH");}
